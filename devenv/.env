# The devenv's pins. Everything the environment runs is named here, once.
#
# These age, deliberately visibly. A pin that has drifted from the Catalogue
# the estate is judged against is a real finding about the product's version
# handling, and it should be read as one rather than bumped in passing
# (ADR-0052).
#
# The Catalogue in devenv/estate/catalogues is imported at the collector
# version below. Moving one means moving both:
#
#   go run ./cmd/catalogue-import -tag v<OTELCOL_VERSION> -out devenv/estate/catalogues

# The telemetry backend. 9.5 is the floor: the native OTLP/HTTP intake at
# /_otlp carries all three signals from that release, and the devenv's
# exporter is pointed straight at it.
BACKEND_VERSION=9.5.2

# The collector, and the Supervisor that runs it. Released in lockstep, so
# these move together.
OTELCOL_VERSION=0.159.0
SUPERVISOR_VERSION=0.159.0

# The telemetry the sims produce, per second per signal. Low enough to sit
# under a laptop's fans, high enough that a five-minute window is never
# ambiguous about whether something arrived.
SIM_RATE=5
