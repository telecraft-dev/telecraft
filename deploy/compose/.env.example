# Copy this file to .env beside compose.yaml and fill it in. Compose reads
# .env from the directory it runs in, so every value below reaches the
# services without anything else being exported.

# The image, with the tag or the digest to run. An air-gapped deployment
# mirrors the image and points this at the mirror, and moving to a new
# release is this one value. Every release names its own digest, which is
# what to pin in place of a tag:
#
#   TELECRAFT_IMAGE=ghcr.io/telecraft-dev/telecraft@sha256:DIGEST
TELECRAFT_IMAGE=ghcr.io/telecraft-dev/telecraft:release

# The estate checkout the Instance serves, and the directory holding the
# secrets it reads. Both are on this host, and both are mounted read only.
ESTATE_DIR=./estate
SECRETS_DIR=./secrets

# What a browser reaches the console at. Over plain HTTP this has to name a
# loopback address, so the value here is what a first run looks like. With a
# terminator in front, name the https URL it answers on.
TELECRAFT_EXTERNAL_URL=http://127.0.0.1:4321

# How often the estate directory is read again.
TELECRAFT_FETCH_INTERVAL=30s

# The telemetry backend the arrival readings are taken from. Leave it empty
# to take none. The credential for it is a file named telemetry-key beside
# the session key, added to the secrets: block in compose.yaml.
TELECRAFT_TELEMETRY_ENDPOINT=

# Where the two Instance addresses are published. The console stays on
# loopback: reach it over a terminator, or through an SSH tunnel. The OpAMP
# endpoint answers collectors on other hosts, so it is published on every
# interface.
#
# With the tls profile running, put both on loopback and let the proxy hold
# the public addresses.
CONSOLE_ADDRESS=127.0.0.1:4321
OPAMP_ADDRESS=0.0.0.0:4320

# The example terminator, started only under the tls profile. TLS_DIR holds
# fullchain.pem and privkey.pem, issued by whatever already issues
# certificates for this host.
PROXY_IMAGE=nginx:1.29-alpine
TLS_DIR=./tls
HTTPS_ADDRESS=0.0.0.0:443
HTTP_ADDRESS=0.0.0.0:80
