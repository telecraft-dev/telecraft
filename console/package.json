{
  "name": "telecraft-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Telecraft console: four Workspaces over the documented platform API (ADR-0042, ADR-0045).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "backend": "node tools/fixture-backend.mjs",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "assemble": "node tools/assemble-site.mjs dist",
    "bundle": "node tools/stage-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "capture": "node tools/capture.mjs",
    "check:zero-cdn": "node tools/check-zero-cdn.mjs dist",
    "check:palette": "node tools/check-palette.mjs",
    "check:bundle-budget": "node tools/check-bundle-budget.mjs dist"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
