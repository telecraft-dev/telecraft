{
  "name": "telecraft-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Telecraft console: four Workspaces over the documented platform API (ADR-0042, ADR-0045).",
  "scripts": {
    "dev": "vite",
    "backend": "node tools/fixture-backend.mjs",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:zero-cdn": "node tools/check-zero-cdn.mjs dist"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-router": "^1.132.0",
    "@xyflow/react": "^12.8.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
